#!/bin/sh

set -eu

output=
input=

while [ "$#" -gt 0 ]; do
    case "$1" in
        -o|--output-file)
            [ "$#" -ge 2 ] || {
                echo "msgfmt wrapper: missing output path" >&2
                exit 2
            }
            output=$2
            shift 2
            ;;
        -c|--check|--statistics)
            shift
            ;;
        -*)
            echo "msgfmt wrapper: unsupported option $1" >&2
            exit 2
            ;;
        *)
            input=$1
            shift
            ;;
    esac
done

[ -n "$input" ] || {
    echo "msgfmt wrapper: missing input file" >&2
    exit 2
}
[ -n "$output" ] || {
    echo "msgfmt wrapper: missing output file" >&2
    exit 2
}

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
gjs -m "$SCRIPT_DIR/compile-po.js" "$input" "$output"
