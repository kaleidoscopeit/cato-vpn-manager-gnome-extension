#!/bin/bash

set -u

IP=/usr/sbin/ip

usage() {
    echo "Usage: cato-vpn-route-helper apply --interface DEVICE [--delete DEST]... [--add DEST]..." >&2
    exit 2
}

valid_interface() {
    [[ $1 =~ ^[A-Za-z0-9_.:-]{1,15}$ ]] && [[ -d /sys/class/net/$1 ]]
}

valid_destination() {
    local destination=$1
    local address prefix octet
    local -a octets

    [[ $destination == default ]] && return 0
    [[ $destination =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}(/[0-9]{1,2})?$ ]] || return 1

    address=${destination%%/*}
    if [[ $destination == */* ]]; then
        prefix=${destination##*/}
        ((10#$prefix <= 32)) || return 1
    fi

    IFS=. read -r -a octets <<< "$address"
    for octet in "${octets[@]}"; do
        ((10#$octet <= 255)) || return 1
    done
}

[[ ${EUID:-$(id -u)} -eq 0 ]] || {
    echo "This helper must be run through pkexec." >&2
    exit 1
}

[[ ${1:-} == apply ]] || usage
shift

interface=
declare -a delete_routes=()
declare -a add_routes=()

while (($#)); do
    case $1 in
        --interface)
            (($# >= 2)) || usage
            interface=$2
            shift 2
            ;;
        --delete)
            (($# >= 2)) || usage
            delete_routes+=("$2")
            shift 2
            ;;
        --add)
            (($# >= 2)) || usage
            add_routes+=("$2")
            shift 2
            ;;
        *)
            usage
            ;;
    esac
done

valid_interface "$interface" || {
    echo "Invalid or unavailable interface: $interface" >&2
    exit 2
}

((${#delete_routes[@]} + ${#add_routes[@]} > 0)) || usage
for destination in "${delete_routes[@]}" "${add_routes[@]}"; do
    valid_destination "$destination" || {
        echo "Invalid route destination: $destination" >&2
        exit 2
    }
done

declare -a added_routes=()

rollback_added_routes() {
    local index
    for ((index=${#added_routes[@]} - 1; index >= 0; index--)); do
        "$IP" route del "${added_routes[index]}" dev "$interface" >/dev/null 2>&1 || true
    done
}

# Add missing routes first so a failed profile does not remove the existing
# Cato paths before the replacement paths are available.
for destination in "${add_routes[@]}"; do
    if "$IP" route show "$destination" dev "$interface" | /usr/bin/grep -q .; then
        continue
    fi

    if ! "$IP" route replace "$destination" dev "$interface"; then
        rollback_added_routes
        exit 1
    fi
    added_routes+=("$destination")
done

for destination in "${delete_routes[@]}"; do
    if "$IP" route show "$destination" dev "$interface" | /usr/bin/grep -q .; then
        "$IP" route del "$destination" dev "$interface" || {
            rollback_added_routes
            exit 1
        }
    fi
done

echo "Route profile applied to $interface."
